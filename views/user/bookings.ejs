<div class="container py-4">
  <h1 class="fw-bold mb-4">My Bookings</h1>
  <div class="card shadow-sm border-0">
    <div class="table-responsive">
      <table class="table table-hover mb-0">
        <thead><tr><th>Ticket</th><th>Event</th><th>Date</th><th>Status</th><th>Actions</th></tr></thead>
        <tbody>
          <% if (bookings.length === 0) { %>
            <tr><td colspan="5" class="text-center text-muted py-4">No bookings yet. <a href="/events">Browse events</a></td></tr>
          <% } else { %>
            <% bookings.forEach(function(b) { %>
              <tr>
                <td><code><%= b.ticketNumber %></code></td>
                <td><%= b.event ? b.event.title : 'Event removed' %></td>
                <td><%= b.event ? formatDateTime(b.event.dateTime.start) : '-' %></td>
                <td><span class="badge bg-<%= getStatusBadge(b.status) %>"><%= b.status %></span></td>
                <td>
                  <% if (b.status === 'confirmed') { %>
                    <form action="/bookings/<%= b._id %>?_method=DELETE" method="POST" class="d-inline" onsubmit="return confirm('Cancel this registration?')">
                      <button type="submit" class="btn btn-sm btn-outline-danger">Cancel</button>
                    </form>
                  <% } %>
                </td>
              </tr>
            <% }); %>
          <% } %>
        </tbody>
      </table>
    </div>
  </div>
  <%- include('../partials/pagination', { pagination, query: {} }) %>
</div>
