<div class="col-md-6 col-lg-4">
  <div class="card event-card h-100 shadow-sm">
    <% if (event.image && event.image.url) { %>
      <img src="<%= event.image.url %>" class="card-img-top event-card-img" alt="<%= event.title %>">
    <% } else { %>
      <div class="event-card-placeholder">
        <i class="bi bi-calendar-event"></i>
      </div>
    <% } %>
    <div class="card-body d-flex flex-column">
      <div class="d-flex justify-content-between align-items-start mb-2">
        <span class="badge bg-primary"><%= getCategoryLabel(event.category) %></span>
        <span class="badge bg-<%= getStatusBadge(event.status) %>"><%= event.status %></span>
      </div>
      <h5 class="card-title"><%= event.title %></h5>
      <p class="card-text text-muted small flex-grow-1">
        <i class="bi bi-geo-alt me-1"></i><%= event.location.city %><br>
        <i class="bi bi-clock me-1"></i><%= formatDateTime(event.dateTime.start) %>
      </p>
      <div class="d-flex justify-content-between align-items-center mt-auto">
        <span class="fw-bold text-primary">
          <%= event.ticketPrice > 0 ? formatCurrency(event.ticketPrice) : 'Free' %>
        </span>
        <a href="/events/<%= event._id %>" class="btn btn-sm btn-outline-primary">View Details</a>
      </div>
    </div>
  </div>
</div>
