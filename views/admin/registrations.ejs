<form action="/admin/registrations" method="GET" class="row g-3 mb-4">
  <div class="col-md-3">
    <select class="form-select" name="status">
      <option value="">All Status</option>
      <option value="confirmed" <%= query.status === 'confirmed' ? 'selected' : '' %>>Confirmed</option>
      <option value="cancelled" <%= query.status === 'cancelled' ? 'selected' : '' %>>Cancelled</option>
      <option value="pending" <%= query.status === 'pending' ? 'selected' : '' %>>Pending</option>
    </select>
  </div>
  <div class="col-md-2"><button type="submit" class="btn btn-primary w-100">Filter</button></div>
</form>

<div class="card shadow-sm border-0">
  <div class="table-responsive">
    <table class="table table-hover mb-0">
      <thead><tr><th>Ticket</th><th>User</th><th>Event</th><th>Status</th><th>Date</th></tr></thead>
      <tbody>
        <% bookings.forEach(function(b) { %>
          <tr>
            <td><code><%= b.ticketNumber %></code></td>
            <td><%= b.user.firstName %> <%= b.user.lastName %><br><small class="text-muted"><%= b.user.email %></small></td>
            <td><%= b.event ? b.event.title : 'N/A' %></td>
            <td><span class="badge bg-<%= getStatusBadge(b.status) %>"><%= b.status %></span></td>
            <td><%= formatDateTime(b.createdAt) %></td>
          </tr>
        <% }); %>
      </tbody>
    </table>
  </div>
</div>
<%- include('../partials/pagination', { pagination, query: query || {} }) %>
