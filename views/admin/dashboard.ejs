<div class="row g-4 mb-4">
  <div class="col-md-3">
    <div class="stat-card dashboard-stat">
      <i class="bi bi-people fs-2 text-primary"></i>
      <h3><%= stats.totalUsers %></h3>
      <p>Total Users</p>
    </div>
  </div>
  <div class="col-md-3">
    <div class="stat-card dashboard-stat">
      <i class="bi bi-calendar3 fs-2 text-success"></i>
      <h3><%= stats.totalEvents %></h3>
      <p>Total Events</p>
    </div>
  </div>
  <div class="col-md-3">
    <div class="stat-card dashboard-stat">
      <i class="bi bi-ticket-perforated fs-2 text-info"></i>
      <h3><%= stats.totalRegistrations %></h3>
      <p>Registrations</p>
    </div>
  </div>
  <div class="col-md-3">
    <div class="stat-card dashboard-stat">
      <i class="bi bi-currency-rupee fs-2 text-warning"></i>
      <h3><%= formatCurrency(stats.totalRevenue) %></h3>
      <p>Total Revenue</p>
    </div>
  </div>
</div>

<div class="row g-4">
  <div class="col-lg-6">
    <div class="card shadow-sm border-0 h-100">
      <div class="card-header bg-transparent"><h5 class="mb-0">Events by Category</h5></div>
      <div class="card-body">
        <% if (eventsByCategory.length === 0) { %>
          <p class="text-muted">No data yet.</p>
        <% } else { %>
          <ul class="list-group list-group-flush">
            <% eventsByCategory.forEach(function(item) { %>
              <li class="list-group-item d-flex justify-content-between">
                <span><%= getCategoryLabel(item._id) %></span>
                <span class="badge bg-primary"><%= item.count %></span>
              </li>
            <% }); %>
          </ul>
        <% } %>
      </div>
    </div>
  </div>
  <div class="col-lg-6">
    <div class="card shadow-sm border-0 h-100">
      <div class="card-header bg-transparent"><h5 class="mb-0">Monthly Revenue</h5></div>
      <div class="card-body">
        <% if (monthlyRevenue.length === 0) { %>
          <p class="text-muted">No revenue data yet.</p>
        <% } else { %>
          <ul class="list-group list-group-flush">
            <% monthlyRevenue.forEach(function(item) { %>
              <li class="list-group-item d-flex justify-content-between">
                <span><%= item._id %></span>
                <span><%= formatCurrency(item.revenue) %> (<%= item.count %> payments)</span>
              </li>
            <% }); %>
          </ul>
        <% } %>
      </div>
    </div>
  </div>
</div>

<div class="card shadow-sm border-0 mt-4">
  <div class="card-header bg-transparent"><h5 class="mb-0">Recent Registrations</h5></div>
  <div class="table-responsive">
    <table class="table table-hover mb-0">
      <thead><tr><th>User</th><th>Event</th><th>Date</th></tr></thead>
      <tbody>
        <% recentBookings.forEach(function(b) { %>
          <tr>
            <td><%= b.user.firstName %> <%= b.user.lastName %></td>
            <td><%= b.event ? b.event.title : 'N/A' %></td>
            <td><%= formatDateTime(b.createdAt) %></td>
          </tr>
        <% }); %>
      </tbody>
    </table>
  </div>
</div>
