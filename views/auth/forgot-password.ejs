<div class="container py-5">
  <div class="row justify-content-center">
    <div class="col-md-5">
      <div class="card shadow-sm border-0">
        <div class="card-body p-4">
          <h2 class="fw-bold text-center mb-4">Forgot Password</h2>
          <p class="text-muted text-center small">Enter your email and we'll send you a reset link.</p>
          <form action="/auth/forgot-password" method="POST">
            <input type="hidden" name="_redirect" value="/auth/forgot-password">
            <div class="mb-3">
              <label for="email" class="form-label">Email</label>
              <input type="email" class="form-control" id="email" name="email" required>
            </div>
            <button type="submit" class="btn btn-primary w-100">Send Reset Link</button>
          </form>
          <div class="text-center mt-3">
            <a href="/auth/login" class="small">Back to Login</a>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
