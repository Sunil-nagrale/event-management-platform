<div class="container py-4">
  <div class="row justify-content-center">
    <div class="col-lg-6">
      <div class="card shadow-sm border-0">
        <div class="card-body p-4 text-center">
          <h2 class="fw-bold mb-3">Checkout</h2>
          <h4><%= event.title %></h4>
          <p class="text-muted"><%= formatDateTime(event.dateTime.start) %></p>
          <p class="text-muted"><i class="bi bi-geo-alt"></i> <%= event.location.venue %>, <%= event.location.city %></p>
          <h3 class="text-primary my-4"><%= formatCurrency(event.ticketPrice) %></h3>

          <% if (isPaymentMock) { %>
            <div class="alert alert-info small text-start">
              <i class="bi bi-info-circle me-1"></i>
              Demo mode: Razorpay is not configured. Use the button below to simulate a successful payment.
            </div>
            <form id="mock-pay-form" action="/payments/mock-pay" method="POST">
              <input type="hidden" name="paymentId" id="mock-payment-id">
              <button type="button" id="mock-pay-btn" class="btn btn-success btn-lg w-100" data-event-id="<%= event._id %>">
                <i class="bi bi-check-circle me-1"></i> Simulate Payment (Demo)
              </button>
            </form>
          <% } else { %>
            <button id="pay-btn" class="btn btn-primary btn-lg w-100 btn-loading" data-event-id="<%= event._id %>">
              <span class="btn-text">Pay with Razorpay</span>
            </button>
          <% } %>

          <a href="/events/<%= event._id %>" class="btn btn-link mt-2">Cancel</a>
        </div>
      </div>
    </div>
  </div>
</div>

<% if (!isPaymentMock) { %>
<script src="https://checkout.razorpay.com/v1/checkout.js"></script>
<script>
document.getElementById('pay-btn').addEventListener('click', async function() {
  const eventId = this.dataset.eventId;
  const btn = this;
  btn.disabled = true;

  try {
    const res = await fetch('/payments/create-order/' + eventId, { method: 'POST', headers: { 'Content-Type': 'application/json' } });
    const data = await res.json();

    if (!data.success) {
      alert(data.message || 'Unable to create order');
      btn.disabled = false;
      return;
    }

    const options = {
      key: data.key,
      amount: data.order.amount,
      currency: data.order.currency,
      name: 'EventHub',
      description: <%- JSON.stringify(event.title) %>,
      order_id: data.order.id,
      handler: function(response) {
        const form = document.createElement('form');
        form.method = 'POST';
        form.action = '/payments/verify';
        const fields = {
          razorpay_order_id: response.razorpay_order_id,
          razorpay_payment_id: response.razorpay_payment_id,
          razorpay_signature: response.razorpay_signature,
          paymentId: data.paymentId
        };
        Object.keys(fields).forEach(function(k) {
          const input = document.createElement('input');
          input.type = 'hidden';
          input.name = k;
          input.value = fields[k];
          form.appendChild(input);
        });
        document.body.appendChild(form);
        form.submit();
      },
      theme: { color: '#6366f1' }
    };

    const rzp = new Razorpay(options);
    rzp.on('payment.failed', function() {
      window.location.href = '/payments/failure';
    });
    rzp.open();
  } catch (err) {
    alert('Payment initialization failed');
  } finally {
    btn.disabled = false;
  }
});
</script>
<% } else { %>
<script>
document.getElementById('mock-pay-btn').addEventListener('click', async function() {
  const eventId = this.dataset.eventId;
  const btn = this;
  btn.disabled = true;
  btn.textContent = 'Processing...';

  try {
    const res = await fetch('/payments/create-order/' + eventId, { method: 'POST', headers: { 'Content-Type': 'application/json' } });
    const data = await res.json();

    if (!data.success) {
      alert(data.message || 'Unable to create order');
      btn.disabled = false;
      btn.innerHTML = '<i class="bi bi-check-circle me-1"></i> Simulate Payment (Demo)';
      return;
    }

    document.getElementById('mock-payment-id').value = data.paymentId;
    document.getElementById('mock-pay-form').submit();
  } catch (err) {
    alert('Payment failed');
    btn.disabled = false;
    btn.innerHTML = '<i class="bi bi-check-circle me-1"></i> Simulate Payment (Demo)';
  }
});
</script>
<% } %>
