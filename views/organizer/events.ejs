<div class="d-flex justify-content-between mb-4">
  <div></div>
  <a href="/events/new" class="btn btn-primary"><i class="bi bi-plus-circle me-1"></i>Create Event</a>
</div>

<div class="card shadow-sm border-0">
  <div class="table-responsive">
    <table class="table table-hover mb-0">
      <thead><tr><th>Title</th><th>Date</th><th>Status</th><th>Registered</th><th>Price</th><th>Actions</th></tr></thead>
      <tbody>
        <% events.forEach(function(event) { %>
          <tr>
            <td><%= event.title %></td>
            <td><%= formatDateTime(event.dateTime.start) %></td>
            <td><span class="badge bg-<%= getStatusBadge(event.status) %>"><%= event.status %></span></td>
            <td><%= event.registeredCount %>/<%= event.capacity %></td>
            <td><%= event.ticketPrice > 0 ? formatCurrency(event.ticketPrice) : 'Free' %></td>
            <td>
              <a href="/events/<%= event._id %>" class="btn btn-sm btn-outline-primary">View</a>
              <a href="/events/<%= event._id %>/edit" class="btn btn-sm btn-outline-secondary">Edit</a>
              <a href="/organizer/events/<%= event._id %>/registrations" class="btn btn-sm btn-outline-info">Registrations</a>
            </td>
          </tr>
        <% }); %>
      </tbody>
    </table>
  </div>
</div>
<%- include('../partials/pagination', { pagination, query: query || {} }) %>
