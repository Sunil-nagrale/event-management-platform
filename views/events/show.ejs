<div class="container py-4">
  <div class="row">
    <div class="col-lg-8">
      <% if (event.image && event.image.url) { %>
        <img src="<%= event.image.url %>" class="img-fluid rounded shadow-sm w-100 event-detail-img mb-4" alt="<%= event.title %>">
      <% } else { %>
        <div class="event-detail-placeholder mb-4">
          <i class="bi bi-calendar-event"></i>
        </div>
      <% } %>

      <div class="d-flex gap-2 mb-3">
        <span class="badge bg-primary fs-6"><%= getCategoryLabel(event.category) %></span>
        <span class="badge bg-<%= getStatusBadge(event.status) %> fs-6"><%= event.status %></span>
      </div>

      <h1 class="fw-bold"><%= event.title %></h1>
      <p class="text-muted"><%= event.description %></p>

      <% if (event.tags && event.tags.length) { %>
        <div class="mb-3">
          <% event.tags.forEach(function(tag) { %>
            <span class="badge bg-light text-dark me-1">#<%= tag %></span>
          <% }); %>
        </div>
      <% } %>
    </div>

    <div class="col-lg-4">
      <div class="card shadow-sm border-0 sticky-top event-info-card">
        <div class="card-body">
          <h4 class="text-primary fw-bold mb-3">
            <%= event.ticketPrice > 0 ? formatCurrency(event.ticketPrice) : 'Free' %>
          </h4>

          <ul class="list-unstyled event-info-list">
            <li><i class="bi bi-calendar3 text-primary"></i> <%= formatDateTime(event.dateTime.start) %></li>
            <li><i class="bi bi-clock text-primary"></i> Until <%= formatDateTime(event.dateTime.end) %></li>
            <li><i class="bi bi-geo-alt text-primary"></i> <%= event.location.venue %>, <%= event.location.city %></li>
            <% if (event.location.address) { %>
              <li><i class="bi bi-pin-map text-primary"></i> <%= event.location.address %></li>
            <% } %>
            <li><i class="bi bi-people text-primary"></i> <%= event.availableSeats %> / <%= event.capacity %> seats available</li>
            <li><i class="bi bi-person text-primary"></i> By <%= event.organizer.firstName %> <%= event.organizer.lastName %></li>
          </ul>

          <% if (event.status === 'published' && !event.isFull) { %>
            <% if (currentUser) { %>
              <% if (userBooking) { %>
                <div class="alert alert-success small mb-0">
                  <i class="bi bi-check-circle me-1"></i>Registered — Ticket: <%= userBooking.ticketNumber %>
                </div>
              <% } else { %>
                <% if (event.ticketPrice > 0) { %>
                  <a href="/payments/checkout/<%= event._id %>" class="btn btn-primary w-100 btn-lg btn-loading">
                    <span class="btn-text">Buy Ticket</span>
                  </a>
                <% } else { %>
                  <form action="/bookings/events/<%= event._id %>" method="POST">
                    <button type="submit" class="btn btn-primary w-100 btn-lg btn-loading">
                      <span class="btn-text">Register Free</span>
                    </button>
                  </form>
                <% } %>
              <% } %>
            <% } else { %>
              <a href="/auth/login" class="btn btn-primary w-100 btn-lg">Login to Register</a>
            <% } %>
          <% } else if (event.isFull) { %>
            <div class="alert alert-warning mb-0">This event is fully booked.</div>
          <% } %>

          <% if (currentUser && (currentUser._id.toString() === event.organizer._id.toString() || currentUser.role === 'admin')) { %>
            <hr>
            <div class="d-grid gap-2">
              <a href="/events/<%= event._id %>/edit" class="btn btn-outline-secondary btn-sm">Edit Event</a>
              <form action="/events/<%= event._id %>?_method=DELETE" method="POST" onsubmit="return confirm('Delete this event?')">
                <button type="submit" class="btn btn-outline-danger btn-sm w-100">Delete Event</button>
              </form>
            </div>
          <% } %>
        </div>
      </div>
    </div>
  </div>
</div>
