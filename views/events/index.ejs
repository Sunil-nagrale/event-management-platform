<div class="container py-4">
  <div class="row mb-4">
    <div class="col-lg-8">
      <h1 class="fw-bold">Browse Events</h1>
      <p class="text-muted">Find your next experience</p>
    </div>
    <% if (currentUser && (currentUser.role === 'organizer' || currentUser.role === 'admin')) { %>
      <div class="col-lg-4 text-lg-end">
        <a href="/events/new" class="btn btn-primary"><i class="bi bi-plus-circle me-1"></i>Create Event</a>
      </div>
    <% } %>
  </div>

  <div class="card shadow-sm border-0 mb-4">
    <div class="card-body">
      <form action="/events" method="GET" class="row g-3">
        <div class="col-md-4">
          <input type="text" class="form-control" name="search" placeholder="Search events..." value="<%= query.search || '' %>">
        </div>
        <div class="col-md-2">
          <select class="form-select" name="category">
            <option value="">All Categories</option>
            <% categories.forEach(function(cat) { %>
              <option value="<%= cat %>" <%= query.category === cat ? 'selected' : '' %>><%= getCategoryLabel(cat) %></option>
            <% }); %>
          </select>
        </div>
        <div class="col-md-2">
          <input type="text" class="form-control" name="city" placeholder="City" value="<%= query.city || '' %>">
        </div>
        <div class="col-md-2">
          <select class="form-select" name="sort">
            <option value="">Sort By</option>
            <option value="date-asc" <%= query.sort === 'date-asc' ? 'selected' : '' %>>Date (Earliest)</option>
            <option value="date-desc" <%= query.sort === 'date-desc' ? 'selected' : '' %>>Date (Latest)</option>
            <option value="price-asc" <%= query.sort === 'price-asc' ? 'selected' : '' %>>Price (Low)</option>
            <option value="price-desc" <%= query.sort === 'price-desc' ? 'selected' : '' %>>Price (High)</option>
          </select>
        </div>
        <div class="col-md-2">
          <button type="submit" class="btn btn-primary w-100"><i class="bi bi-funnel me-1"></i>Filter</button>
        </div>
      </form>
    </div>
  </div>

  <div class="row g-4">
    <% if (events.length === 0) { %>
      <div class="col-12 text-center py-5">
        <i class="bi bi-calendar-x fs-1 text-muted"></i>
        <p class="text-muted mt-3">No events found matching your criteria.</p>
      </div>
    <% } else { %>
      <% events.forEach(function(event) { %>
        <%- include('../partials/event-card', { event }) %>
      <% }); %>
    <% } %>
  </div>

  <%- include('../partials/pagination', { pagination, query: query || {} }) %>
</div>
